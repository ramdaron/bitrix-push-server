{
	"servers": [
		{
			"name": "sub-__PORT__",
			"port": __PORT__,
			"hostname": "127.0.0.1",
			"backlog": 1024,
			"routes": {
				"sub": "/sub2/"
			}
		}
	],
	"clusterMode": true,
	"processUniqueId": "sub-__PORT__",
	"storage": {
		"type": "redis",
		"socket": "/tmp/redis.sock",
		"messageTLL": 86400,
		"channelTLL": 86400,
		"onlineTLL": 120,
		"onlineDelta": 10
	},
	"security": {
		"key": "__SECURITY_KEY__"
	},
	"debug": {
		"ip": [
			__IP_LIST__
		],
		"folderName": "/var/log/push-server"
	}
}
